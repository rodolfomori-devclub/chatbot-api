# Configuração do Servidor
PORT=3001

# Provedor principal de LLM: 'openai', 'gemini' ou 'groq'
LLM_PROVIDER=openai

# Cadeia de fallback automático. Se o provedor principal falhar, o servidor
# tenta estes na ordem antes de cair no texto engessado dos locales.
# Provedores sem chave configurada são pulados automaticamente.
LLM_FALLBACK_PROVIDERS=gemini,groq

# Quantas mensagens da conversa vão junto na chamada à LLM.
# O system prompt da Giovanna fica FORA dessa conta — ele nunca é descartado.
HISTORY_TURNS=8

# OpenAI (principal)
# Obtenha sua chave em: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Modelo OpenAI. Precisa ser multimodal para o aluno mandar print de layout.
# Opções: gpt-5.4-mini (bom custo/velocidade), gpt-5.5 (mais inteligente),
#         gpt-5.4-nano (mais barato e mais fraco)
OPENAI_MODEL=gpt-5.4-mini

# Gemini (fallback) — usa o endpoint compatível com o formato da OpenAI
# Obtenha sua chave em: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Groq (último fallback) — rápido e barato, mas NÃO enxerga imagens,
# então é pulado automaticamente quando o aluno anexa um print.
# Obtenha sua chave em: https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Configuração de Idioma
# pt = Português, es = Espanhol, en = Inglês
DEFAULT_LANGUAGE=pt

# Configuração de Segurança
# Tempo limite para requisições da API (em segundos)
API_TIMEOUT=30

# Configuração de Logs
# true = logs detalhados, false = logs básicos
DEBUG_MODE=true
